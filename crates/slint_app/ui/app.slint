// TweMusic in Slint. The window only draws: all data and playback come from the Rust side
// (twe_music::engine), which fills the properties below and handles the callbacks.

struct Song {
    title: string,
    artist: string,
    tint: color,
    art: image,
}

// Colours that follow the album art of the current song. The Rust side sets them.
export global Palette {
    in property <color> background: #15111d;
    in property <color> accent: #4f378b;
    in property <color> primary: #d0bcff;
    in property <color> on-primary: #381e72;
    in property <color> aurora-a: #4f378b;
    in property <color> aurora-b: #3b6a8a;
    in property <color> on-surface: #f4eefc;
    in property <color> on-surface-variant: #b9aecb;
    // Cards, the rail and the player bar: translucent, tinted by the album art.
    in property <color> glass: #ffffff14;
    in property <color> glass-hover: #ffffff26;
    in property <color> glass-solid: #2a2438;
}

struct Entry {
    title: string,
    artist: string,
    tint: color,
    art: image,
    liked: bool,
    duration: string,
}

global Glyphs {
    out property <string> heart: "M16.5 3c-1.74 0-3.41.81-4.5 2.09C10.91 3.81 9.24 3 7.5 3 4.42 3 2 5.42 2 8.5c0 3.78 3.4 6.86 8.55 11.54L12 21.35l1.45-1.32C18.6 15.36 22 12.28 22 8.5 22 5.42 19.58 3 16.5 3zm-4.4 15.55l-.1.1-.1-.1C7.14 14.24 4 11.39 4 8.5 4 6.5 5.5 5 7.5 5c1.54 0 3.04.99 3.57 2.36h1.87C13.46 5.99 14.96 5 16.5 5c2 0 3.5 1.5 3.5 3.5 0 2.89-3.14 5.74-7.9 10.05z";
    out property <string> heart-filled: "M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z";
    out property <string> search: "M15.5 14h-.79l-.28-.27A6.471 6.471 0 0016 9.5 6.5 6.5 0 109.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z";
    out property <string> close: "M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z";
}

component Icon inherits Path {
    in property <string> glyph;
    in property <length> size: 24px;
    width: size;
    height: size;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: glyph;
    fill: #e8e0f0;
}

// Lets its parent be reached with Tab and used with Space or Enter, and draws a focus ring.
component Focusable inherits Rectangle {
    in property <length> ring-radius: 12px;
    callback activated();
    fs := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.activated();
                return accept;
            }
            reject
        }
    }
    Rectangle {
        border-radius: root.ring-radius;
        border-width: fs.has-focus ? 3px : 0px;
        border-color: #ffffff;
        animate border-width { duration: 100ms; }
    }
}

component RailItem inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> selected;
    callback clicked();
    width: 80px;
    height: 64px;
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: root.selected ? 56px : 36px;
                animate width { duration: 320ms; easing: cubic-bezier(0.3, 1.3, 0.64, 1); }
                height: 32px;
                border-radius: ta.pressed ? 10px : 16px;
                animate border-radius { duration: 260ms; easing: cubic-bezier(0.3, 1.3, 0.64, 1); }
                background: root.selected ? Palette.accent : (ta.pressed ? Palette.glass-hover : (ta.has-hover ? Palette.glass : #00000000));
                animate background { duration: 150ms; easing: ease-out; }
                Icon {
                    glyph: root.glyph;
                    size: 22px;
                    fill: root.selected ? #ffffff : #cfc6dc;
                }
            }
        }
        Text {
            text: root.label;
            horizontal-alignment: center;
            font-size: 12px;
            font-weight: root.selected ? 700 : 500;
            color: root.selected ? #ffffff : #cfc6dc;
        }
    }
    Focusable {
        ring-radius: 20px;
        activated => { root.clicked(); }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Artwork, or a tinted gradient until the picture has loaded.
component Art inherits Rectangle {
    in property <color> tint;
    in property <image> source;
    border-radius: 14px;
    animate border-radius { duration: 380ms; easing: cubic-bezier(0.3, 1.3, 0.64, 1); }
    clip: true;
    background: @linear-gradient(135deg, root.tint 0%, root.tint.darker(0.5) 100%);
    Image {
        source: root.source;
        width: parent.width;
        height: parent.height;
        image-fit: cover;
        visible: root.source.width > 0;
    }
}

component RoundButton inherits Rectangle {
    in property <string> glyph;
    in property <length> diameter: 48px;
    in property <length> icon-size: 24px;
    in property <color> fill: Palette.glass-hover;
    in property <color> ink: #e8e0f0;
    // Corner radius at rest; it squeezes while pressed and springs back. The curve approximates
    // Material 3 Expressive's fast spatial spring (damping 0.6, stiffness 800: about 9% overshoot).
    in property <length> rest-radius: diameter / 2;
    // Optional outline drawn from Rust (a white mask); when set it replaces the plain rounded box.
    in property <image> shape-image;
    in property <image> loader-image;
    in property <bool> busy: false;
    callback clicked();
    width: diameter;
    height: diameter;
    property <bool> shaped: root.shape-image.width > 0;
    property <color> shown: ta.pressed ? fill.brighter(0.4) : (ta.has-hover ? fill.brighter(0.2) : fill);
    border-radius: root.shaped ? 0px : (ta.pressed ? min(root.rest-radius, root.diameter * 0.28) : root.rest-radius);
    animate border-radius { duration: 260ms; easing: cubic-bezier(0.3, 1.3, 0.64, 1); }
    background: root.shaped ? #00000000 : root.shown;
    animate background { duration: 100ms; }
    if root.shaped: Image {
        width: parent.width;
        height: parent.height;
        source: root.shape-image;
        colorize: root.shown;
    }
    if root.shaped && root.busy: Image {
        width: parent.width;
        height: parent.height;
        source: root.loader-image;
        colorize: root.ink;
    }
    if !root.busy: Icon {
        glyph: root.glyph;
        size: root.icon-size;
        fill: root.ink;
    }
    Focusable {
        ring-radius: root.border-radius;
        activated => { root.clicked(); }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

component QuickCard inherits Rectangle {
    in property <Song> song;
    callback clicked();
    height: 56px;
    border-radius: 12px;
    background: ta.has-hover ? Palette.glass-hover : Palette.glass;
    animate background { duration: 120ms; }
    Rectangle {
        border-radius: root.border-radius;
        background: ta.pressed ? #ffffff1a : #00000000;
        animate background { duration: 80ms; }
    }
    HorizontalLayout {
        spacing: 12px;
        Art {
            width: 56px;
            tint: root.song.tint;
            source: root.song.art;
            border-radius: 12px;
        }
        Text {
            text: root.song.title;
            vertical-alignment: center;
            overflow: elide;
            font-size: 14px;
            font-weight: 700;
            color: Palette.on-surface;
        }
    }
    Focusable {
        ring-radius: root.border-radius;
        activated => { root.clicked(); }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

component ShelfCard inherits Rectangle {
    in property <Song> song;
    callback clicked();
    width: 156px;
    height: 220px;
    opacity: ta.pressed ? 0.82 : 1.0;
    animate opacity { duration: 120ms; }
    VerticalLayout {
        spacing: 6px;
        Art {
            height: 156px;
            tint: root.song.tint;
            source: root.song.art;
        }
        Text {
            text: root.song.title;
            overflow: elide;
            font-size: 14px;
            font-weight: 600;
            color: Palette.on-surface;
        }
        Text {
            text: root.song.artist;
            overflow: elide;
            font-size: 12px;
            color: Palette.on-surface-variant;
        }
    }
    Focusable {
        ring-radius: 12px;
        activated => { root.clicked(); }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

component Shelf inherits VerticalLayout {
    in property <string> heading;
    in property <[Song]> songs;
    callback picked(int);
    spacing: 8px;
    Text {
        text: root.heading;
        font-size: 22px;
        font-weight: 700;
        color: Palette.on-surface;
    }
    Flickable {
        height: 220px;
        HorizontalLayout {
            spacing: 14px;
            for song[i] in root.songs : ShelfCard {
                song: song;
                clicked => { root.picked(i); }
            }
        }
    }
}

component PickCard inherits Rectangle {
    in property <Song> song;
    in property <string> why;
    in property <bool> playing;
    callback clicked();
    height: 148px;
    border-radius: 28px;
    background: ta.has-hover ? Palette.accent.with-alpha(0.8) : Palette.accent.with-alpha(0.6);
    animate background { duration: 150ms; }
    HorizontalLayout {
        padding: 14px;
        spacing: 16px;
        Art {
            width: 120px;
            tint: root.song.tint;
            source: root.song.art;
            border-radius: 18px;
        }
        VerticalLayout {
            spacing: 4px;
            Text {
                text: "TODAY'S PICK";
                font-size: 12px;
                font-weight: 700;
                color: Palette.primary;
            }
            Text {
                text: root.song.title;
                font-size: 20px;
                font-weight: 700;
                color: #ffffff;
                overflow: elide;
            }
            Text {
                text: root.song.artist;
                font-size: 14px;
                color: #e8def8;
                overflow: elide;
            }
            Text {
                text: root.why;
                font-size: 12px;
                color: #cfc6dc;
            }
        }
        Rectangle {
            width: 48px;
            Rectangle {
                y: parent.height - self.height;
                width: 48px;
                height: 48px;
                border-radius: 24px;
                background: Palette.primary;
                Icon {
                    glyph: root.playing ? "M6 19h4V5H6v14zm8-14v14h4V5h-4z" : "M8 5v14l11-7z";
                    size: 24px;
                    fill: Palette.on-primary;
                }
            }
        }
    }
    Focusable {
        ring-radius: root.border-radius;
        activated => { root.clicked(); }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A thin seek bar: tap or drag to jump.
component SeekBar inherits Rectangle {
    in property <float> progress;
    // While a song plays the played part is a moving wave, drawn by Rust as a picture so its
    // length and height are exact.
    in property <image> wave-image;
    in property <float> wave-extent: 0;
    out property <length> bar-width: self.width;
    callback seek(float);
    height: 20px;
    fs := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.RightArrow && !event.modifiers.control) {
                root.seek(clamp(root.progress + 0.02, 0, 1));
                return accept;
            }
            if (event.text == Key.LeftArrow && !event.modifiers.control) {
                root.seek(clamp(root.progress - 0.02, 0, 1));
                return accept;
            }
            reject
        }
    }
    Rectangle {
        // While the wave is shown the track only runs from its end, so no line shows behind it.
        x: root.wave-image.width > 0 ? parent.width * clamp(root.progress, 0, 1) : 0px;
        width: parent.width - self.x;
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: Palette.glass-hover;
        Rectangle {
            x: 0px;
            width: parent.width * clamp(root.progress, 0, 1);
            border-radius: 2px;
            background: Palette.primary;
            visible: root.wave-image.width == 0;
        }
    }
    if root.wave-image.width > 0 : Image {
        source: root.wave-image;
        colorize: Palette.primary;
        x: 0px;
        y: (parent.height - 12px) / 2;
        width: root.wave-extent * 1px;
        height: 12px;
        image-fit: fill;
    }
    Rectangle {
        x: parent.width * clamp(root.progress, 0, 1) - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Palette.primary;
        border-width: fs.has-focus ? 3px : 0px;
        border-color: #ffffff;
    }
    TouchArea {
        clicked => { root.seek(clamp(self.mouse-x / self.width, 0, 1)); }
        moved => {
            if (self.pressed) {
                root.seek(clamp(self.mouse-x / self.width, 0, 1));
            }
        }
    }
}

component TextButton inherits Rectangle {
    in property <string> text;
    in property <bool> filled: true;
    in property <bool> destructive: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 40px;
    border-radius: ta.pressed ? 12px : 20px;
    animate border-radius { duration: 260ms; easing: cubic-bezier(0.3, 1.3, 0.64, 1); }
    opacity: root.enabled ? 1.0 : 0.38;
    background: root.destructive ? (ta.has-hover ? #8c3a4a : #7a2f3f)
        : (root.filled ? (ta.has-hover ? Palette.accent.brighter(0.25) : Palette.accent) : (ta.has-hover ? Palette.glass-hover : Palette.glass));
    animate background { duration: 120ms; }
    Rectangle {
        border-radius: root.border-radius;
        background: ta.pressed ? #ffffff1a : #00000000;
        animate background { duration: 80ms; }
    }
    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        Text {
            text: root.text;
            vertical-alignment: center;
            font-size: 14px;
            font-weight: 600;
            color: #ffffff;
        }
    }
    Focusable {
        ring-radius: root.border-radius;
        activated => { if (root.enabled) { root.clicked(); } }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();
    height: 36px;
    border-radius: ta.pressed ? 10px : 18px;
    animate border-radius { duration: 260ms; easing: cubic-bezier(0.3, 1.3, 0.64, 1); }
    background: root.selected ? Palette.accent : (ta.has-hover ? Palette.glass-hover : Palette.glass);
    animate background { duration: 150ms; easing: ease-out; }
    Rectangle {
        border-radius: root.border-radius;
        background: ta.pressed ? #ffffff1a : #00000000;
        animate background { duration: 80ms; }
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        Text {
            text: root.label;
            vertical-alignment: center;
            font-size: 14px;
            font-weight: 600;
            color: Palette.on-surface;
        }
    }
    Focusable {
        ring-radius: root.border-radius;
        activated => { root.clicked(); }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A single-line text field on a glass pill.
component Field inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <bool> auto-focus: false;
    callback accepted();
    height: 48px;
    border-radius: 24px;
    background: Palette.glass;
    public function focus-input() { input.focus(); }
    init => {
        if (root.auto-focus) {
            input.focus();
        }
    }
    Text {
        x: 20px;
        text: root.placeholder;
        visible: input.text == "";
        vertical-alignment: center;
        height: parent.height;
        font-size: 15px;
        color: Palette.on-surface-variant;
    }
    input := TextInput {
        x: 20px;
        width: parent.width - 40px;
        height: parent.height;
        vertical-alignment: center;
        single-line: true;
        font-size: 15px;
        color: Palette.on-surface;
        accepted => { root.accepted(); }
    }
}

component TrackRow inherits Rectangle {
    in property <Entry> entry;
    in property <string> action-glyph;
    in property <bool> action-active;
    callback clicked();
    callback action();
    height: 64px;
    border-radius: 14px;
    background: ta.has-hover ? Palette.glass : #00000000;
    animate background { duration: 120ms; }
    Rectangle {
        border-radius: root.border-radius;
        background: ta.pressed ? #ffffff1a : #00000000;
        animate background { duration: 80ms; }
    }
    Focusable {
        ring-radius: root.border-radius;
        activated => { root.clicked(); }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding: 8px;
        spacing: 12px;
        Art {
            width: 48px;
            tint: root.entry.tint;
            source: root.entry.art;
            border-radius: 10px;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.entry.title;
                overflow: elide;
                font-size: 15px;
                font-weight: 600;
                color: Palette.on-surface;
            }
            Text {
                text: root.entry.artist;
                overflow: elide;
                font-size: 13px;
                color: Palette.on-surface-variant;
            }
        }
        Text {
            text: root.entry.duration;
            vertical-alignment: center;
            font-size: 13px;
            color: Palette.on-surface-variant;
        }
        RoundButton {
            glyph: root.action-glyph;
            diameter: 40px;
            icon-size: 20px;
            fill: #00000000;
            ink: root.action-active ? #ffb4c8 : #cfc6dc;
            clicked => { root.action(); }
        }
    }
}

component SwitchRow inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in-out property <bool> on;
    callback toggled(bool);
    height: 72px;
    border-radius: 20px;
    background: Palette.glass;
    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                font-size: 16px;
                font-weight: 600;
                color: Palette.on-surface;
            }
            Text {
                text: root.description;
                overflow: elide;
                font-size: 13px;
                color: Palette.on-surface-variant;
            }
        }
        Rectangle {
            width: 52px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 32px;
                    border-radius: 16px;
                    background: root.on ? Palette.accent : #4a4458;
                    animate background { duration: 150ms; }
                    Rectangle {
                        x: root.on ? parent.width - self.width - 4px : 4px;
                        y: 4px;
                        width: 24px;
                        height: 24px;
                        border-radius: 12px;
                        background: root.on ? #ffffff : #cfc6dc;
                        animate x { duration: 150ms; easing: ease-out; }
                    }
                }
            }
        }
    }
    Focusable {
        ring-radius: root.border-radius;
        activated => {
            root.on = !root.on;
            root.toggled(root.on);
        }
    }
    TouchArea {
        clicked => {
            root.on = !root.on;
            root.toggled(root.on);
        }
    }
}

export component AppWindow inherits Window {
    title: "TweMusic";
    preferred-width: 1100px;
    preferred-height: 760px;
    min-width: 640px;
    min-height: 520px;
    background: Palette.background;

    // Home
    in property <string> greeting: "Hello";
    in property <bool> has-pick: false;
    in property <Song> pick;
    in property <string> pick-why;
    in property <[Song]> more;
    in property <[Song]> quick;
    in property <[Song]> recent;
    in property <[Song]> liked;

    // Player
    in property <bool> has-track: false;
    in property <string> now-title: "Nothing playing";
    in property <string> now-artist: "Pick a song to start";
    in property <string> now-message;
    in property <image> now-art;
    in property <bool> playing: false;
    in property <bool> loading: false;
    in property <image> wave-image;
    in property <image> now-art-shaped;
    in property <image> big-art;
    in property <image> play-shape;
    in property <image> loader-shape;
    in property <float> wave-extent: 0;
    out property <length> seek-width: seek.bar-width;
    in property <bool> now-liked: false;
    in property <float> progress: 0;
    // Length of the current song in seconds (0 when unknown); the arrow keys seek 5 s at a time.
    in property <float> now-length: 0;
    // The progress shown on the bar: the reported one, moved on smoothly between reports (set by Rust).
    in property <float> smooth-progress: 0;
    in property <string> time-position: "0:00";
    in property <string> time-duration: "0:00";

    // A short message at the bottom (errors, confirmations); empty hides it.
    in property <string> notice;

    callback play-pick();
    callback play-more(int);
    callback play-recent(int);
    callback play-liked(int);
    callback toggle-pause();
    callback next();
    callback previous();
    callback seek(float);
    callback toggle-like();

    // Screens: 0 Home, 1 Library, 2 Settings, 3 Search
    in-out property <int> screen: 0;
    in-out property <int> return-screen: 0;

    // Search
    in-out property <bool> search-open: false;
    in-out property <string> query;
    in property <string> search-status;
    in property <[Entry]> results;
    callback search(string);
    callback play-result(int);
    callback like-result(int);

    // Library
    in property <[string]> playlists;
    in-out property <int> selected-playlist: 0;
    in property <string> playlist-title;
    in property <[Entry]> library-rows;
    in property <[Entry]> up-next-rows;
    in-out property <string> new-playlist;
    in-out property <string> import-url;
    callback select-playlist(int);
    callback create-playlist(string);
    callback import-playlist(string);
    callback play-playlist();
    callback delete-playlist();
    callback remove-track(int);
    callback play-library(int);
    callback play-up-next(int);
    callback like-up-next(int);

    // Settings
    in-out property <bool> set-notifications: true;
    in-out property <bool> set-tray: false;
    in-out property <bool> set-dynamic-color: true;
    callback settings-changed(string, bool);

    // The page column: right of the rail (32 + 80 + 24), with a 32 margin on the right.
    property <length> column-width: root.width - 136px - 32px;

    function open-search() {
        if (root.screen != 3) {
            root.return-screen = root.screen;
            root.screen = 3;
        }
        root.search-open = true;
        search-field.focus-input();
    }
    // The Up next page (screen 4); the same button leaves it again.
    function toggle-up-next() {
        if (root.screen == 4) {
            root.screen = root.return-screen;
        } else {
            if (root.screen != 3) {
                root.return-screen = root.screen;
            }
            root.search-open = false;
            root.screen = 4;
        }
    }
    function close-search() {
        root.search-open = false;
        if (root.results.length == 0) {
            root.screen = root.return-screen;
        }
        keys.focus();
    }
    init => { keys.focus(); }

    // Everything sits inside one focus scope: Space plays or pauses, / searches, Escape closes
    // the search, Left and Right seek 5 seconds, Ctrl+Left and Ctrl+Right go to the previous and
    // next song.
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == " ") {
                root.toggle-pause();
                return accept;
            }
            if (event.text == Key.Escape && root.search-open) {
                root.close-search();
                return accept;
            }
            if (event.text == "/") {
                root.open-search();
                return accept;
            }
            if (!event.modifiers.control && event.text == Key.RightArrow) {
                root.seek(clamp(root.progress + 5 / Math.max(root.now-length, 1), 0, 1));
                return accept;
            }
            if (!event.modifiers.control && event.text == Key.LeftArrow) {
                root.seek(clamp(root.progress - 5 / Math.max(root.now-length, 1), 0, 1));
                return accept;
            }
            if (event.modifiers.control && event.text == Key.RightArrow) {
                root.next();
                return accept;
            }
            if (event.modifiers.control && event.text == Key.LeftArrow) {
                root.previous();
                return accept;
            }
            reject
        }

    // Aurora: soft colour blobs behind everything.
    Rectangle {
        background: @radial-gradient(circle, Palette.aurora-a.with-alpha(0.5) 0%, #00000000 70%);
        x: -200px;
        y: -240px;
        width: 900px;
        height: 900px;
    }
    Rectangle {
        background: @radial-gradient(circle, Palette.aurora-b.with-alpha(0.3) 0%, #00000000 70%);
        x: parent.width - 600px;
        y: parent.height - 600px;
        width: 800px;
        height: 800px;
    }

    // Floating rail: a glass pill at the left, centred vertically.
    Rectangle {
        x: 32px;
        y: (parent.height - self.height) / 2;
        width: 80px;
        height: 3 * 64px + 2 * 4px + 24px;
        border-radius: 28px;
        background: Palette.glass;
        VerticalLayout {
            padding-top: 12px;
            padding-bottom: 12px;
            spacing: 4px;
            RailItem {
                glyph: "M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z";
                label: "Home";
                selected: root.screen == 0;
                clicked => { root.screen = 0; }
            }
            RailItem {
                glyph: "M20 2H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-2 5h-3v5.5c0 1.38-1.12 2.5-2.5 2.5S10 13.88 10 12.5s1.12-2.5 2.5-2.5c.57 0 1.08.19 1.5.51V5h4v2zM4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6z";
                label: "Library";
                selected: root.screen == 1;
                clicked => { root.screen = 1; }
            }
            RailItem {
                glyph: "M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 00.12-.61l-1.92-3.32a.488.488 0 00-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.484.484 0 00-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58a.49.49 0 00-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z";
                label: "Settings";
                selected: root.screen == 2;
                clicked => { root.screen = 2; }
            }
        }
    }

    // Page column: top bar, content, player. Its right margin equals the rail's left margin.
    VerticalLayout {
        x: 32px + 80px + 24px;
        width: parent.width - self.x - 32px;
        height: parent.height;

        // Top bar. The search box grows out of the button on the right until it covers the title
        // (which fades away), and shrinks back the same way.
        Rectangle {
            height: 64px;
            Text {
                text: "TweMusic";
                x: 0px;
                width: 200px;
                horizontal-alignment: left;
                vertical-alignment: center;
                height: parent.height;
                font-size: 24px;
                font-weight: 700;
                color: Palette.on-surface;
                opacity: root.search-open ? 0 : 1;
                animate opacity { duration: root.search-open ? 120ms : 220ms; delay: root.search-open ? 0ms : 160ms; }
            }
            Rectangle {
                width: root.search-open ? parent.width : 44px;
                height: 44px;
                x: parent.width - self.width;
                y: (parent.height - self.height) / 2;
                border-radius: 22px;
                background: root.search-open ? Palette.glass-solid : (root.screen == 3 ? Palette.accent : #00000000);
                animate width { duration: 420ms; easing: cubic-bezier(0.3, 1.15, 0.64, 1); }
                animate background { duration: 200ms; }
                search-field := Field {
                    x: 8px;
                    width: parent.width - 52px;
                    height: 44px;
                    background: #00000000;
                    placeholder: "Search songs, artists, albums";
                    text <=> root.query;
                    opacity: root.search-open ? 1 : 0;
                    animate opacity { duration: root.search-open ? 220ms : 90ms; delay: root.search-open ? 160ms : 0ms; }
                    accepted => { root.search(root.query); }
                }
                RoundButton {
                    x: parent.width - 44px;
                    glyph: Glyphs.search;
                    diameter: 44px;
                    fill: #00000000;
                    ink: root.search-open || root.screen == 3 ? #ffffff : #e8e0f0;
                    clicked => {
                        if (root.search-open && root.query != "") {
                            root.search(root.query);
                        } else if (root.search-open) {
                            root.close-search();
                        } else {
                            root.open-search();
                        }
                    }
                }
            }
        }

        if root.screen == 0 : Rectangle {
            vertical-stretch: 1;
            Flickable {
                width: parent.width;
                height: parent.height;
            content-width: root.column-width;
            VerticalLayout {
                width: root.column-width;
                alignment: start;
                spacing: 20px;
                padding-bottom: 168px;
                Text {
                    text: root.greeting;
                    font-size: 32px;
                    font-weight: 700;
                    color: Palette.on-surface;
                }
                if root.has-pick : PickCard {
                    song: root.pick;
                    why: root.pick-why;
                    playing: root.playing && root.now-title == root.pick.title;
                    clicked => { root.play-pick(); }
                }
                GridLayout {
                    spacing: 8px;
                    for song[i] in root.quick : QuickCard {
                        row: floor(i / 2);
                        col: mod(i, 2);
                        song: song;
                        clicked => { root.play-recent(i); }
                    }
                }
                if root.more.length > 0 : Shelf {
                    heading: "More like today's pick";
                    songs: root.more;
                    picked(i) => { root.play-more(i); }
                }
                if root.recent.length > 0 : Shelf {
                    heading: "Recently played";
                    songs: root.recent;
                    picked(i) => { root.play-recent(i); }
                }
                if root.liked.length > 0 : Shelf {
                    heading: "Liked songs";
                    songs: root.liked;
                    picked(i) => { root.play-liked(i); }
                }
                if !root.has-pick && root.recent.length == 0 && root.liked.length == 0 : Text {
                    text: "Finding something for you…";
                    font-size: 16px;
                    color: Palette.on-surface-variant;
                }
            }
        }
        }

        // Now playing: the big artwork on the left, what is queued next on the right.
        if root.screen == 4 : HorizontalLayout {
            padding-bottom: 24px + 128px + 14px;
            spacing: 16px;
            Rectangle {
                horizontal-stretch: 1;
                border-radius: 28px;
                background: Palette.glass;
                property <length> side: max(120px, min(self.height - 150px, self.width - 64px));
                Image {
                    visible: root.big-art.width > 0;
                    source: root.big-art;
                    width: parent.side;
                    height: parent.side;
                    x: (parent.width - self.width) / 2;
                    y: 24px;
                    image-fit: fill;
                }
                Art {
                    visible: root.big-art.width == 0;
                    tint: Palette.accent;
                    source: root.now-art;
                    border-radius: 40px;
                    width: parent.side;
                    height: parent.side;
                    x: (parent.width - self.width) / 2;
                    y: 24px;
                }
                Text {
                    text: root.now-title;
                    x: 24px;
                    y: 24px + parent.side + 14px;
                    width: parent.width - 48px;
                    horizontal-alignment: center;
                    overflow: elide;
                    font-size: 22px;
                    font-weight: 700;
                    color: Palette.on-surface;
                }
                Text {
                    text: root.now-artist;
                    x: 24px;
                    y: 24px + parent.side + 46px;
                    width: parent.width - 48px;
                    horizontal-alignment: center;
                    overflow: elide;
                    font-size: 15px;
                    color: Palette.on-surface-variant;
                }
            }
            if root.column-width > 760px : Rectangle {
                width: clamp(300px, root.column-width * 0.32, 400px);
                border-radius: 28px;
                background: Palette.glass;
                Text {
                    x: 20px;
                    y: 16px;
                    text: root.up-next-rows.length > 0 ? "Up next" : "Nothing queued yet";
                    font-size: 18px;
                    font-weight: 700;
                    color: Palette.on-surface;
                }
                Flickable {
                    x: 8px;
                    y: 56px;
                    width: parent.width - 16px;
                    height: parent.height - 64px;
                    content-width: self.width;
                    VerticalLayout {
                        width: parent.width;
                        alignment: start;
                        spacing: 2px;
                        padding-bottom: 164px;
                        for entry[i] in root.up-next-rows : TrackRow {
                            entry: entry;
                            action-glyph: entry.liked ? Glyphs.heart-filled : Glyphs.heart;
                            action-active: entry.liked;
                            clicked => { root.play-up-next(i); }
                            action => { root.like-up-next(i); }
                        }
                    }
                }
            }
        }

        // Search results
        if root.screen == 3 : VerticalLayout {
            spacing: 8px;
            Text {
                text: root.search-status != "" ? root.search-status : "Search for songs, artists and albums.";
                font-size: 14px;
                color: Palette.on-surface-variant;
            }
            Rectangle {
                vertical-stretch: 1;
                Flickable {
                    width: parent.width;
                    height: parent.height;
                content-width: root.column-width;
                VerticalLayout {
                    width: root.column-width;
                alignment: start;
                    spacing: 2px;
                    padding-bottom: 164px;
                    for entry[i] in root.results : TrackRow {
                        entry: entry;
                        action-glyph: entry.liked ? Glyphs.heart-filled : Glyphs.heart;
                        action-active: entry.liked;
                        clicked => {
                            root.play-result(i);
                            root.search-open = false;
                            keys.focus();
                        }
                        action => { root.like-result(i); }
                    }
                }
            }
            }
        }

        // Library
        if root.screen == 1 : Rectangle {
            vertical-stretch: 1;
            Flickable {
                width: parent.width;
                height: parent.height;
            content-width: root.column-width;
            VerticalLayout {
                width: root.column-width;
                alignment: start;
                spacing: 14px;
                padding-bottom: 168px;
                Text {
                    text: "Library";
                    font-size: 32px;
                    font-weight: 700;
                    color: Palette.on-surface;
                }
                Text {
                    text: "Liked songs and playlists are saved on this computer.";
                    font-size: 14px;
                    color: Palette.on-surface-variant;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Field {
                        horizontal-stretch: 1;
                        text <=> root.new-playlist;
                        placeholder: "New playlist name";
                        accepted => { root.create-playlist(root.new-playlist); }
                    }
                    VerticalLayout {
                        alignment: center;
                        TextButton {
                            text: "Create";
                            clicked => { root.create-playlist(root.new-playlist); }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Field {
                        horizontal-stretch: 1;
                        text <=> root.import-url;
                        placeholder: "Import a public playlist link";
                        accepted => { root.import-playlist(root.import-url); }
                    }
                    VerticalLayout {
                        alignment: center;
                        TextButton {
                            text: "Import";
                            clicked => { root.import-playlist(root.import-url); }
                        }
                    }
                }
                Flickable {
                    height: 40px;
                    HorizontalLayout {
                        spacing: 8px;
                        for name[i] in root.playlists : Chip {
                            label: name;
                            selected: root.selected-playlist == i;
                            clicked => { root.select-playlist(i); }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: root.playlist-title;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                        font-size: 22px;
                        font-weight: 700;
                        color: Palette.on-surface;
                    }
                    VerticalLayout {
                        alignment: center;
                        TextButton {
                            text: "Play all";
                            enabled: root.library-rows.length > 0;
                            clicked => { root.play-playlist(); }
                        }
                    }
                    if root.selected-playlist > 0 : VerticalLayout {
                        alignment: center;
                        TextButton {
                            text: "Delete";
                            destructive: true;
                            clicked => { root.delete-playlist(); }
                        }
                    }
                }
                if root.library-rows.length == 0 : Text {
                    text: "Nothing here yet. Like songs or add them from search results, or import a playlist link.";
                    wrap: word-wrap;
                    font-size: 14px;
                    color: Palette.on-surface-variant;
                }
                for entry[i] in root.library-rows : TrackRow {
                    entry: entry;
                    action-glyph: Glyphs.close;
                    clicked => { root.play-library(i); }
                    action => { root.remove-track(i); }
                }
            }
        }
        }

        // Settings
        if root.screen == 2 : Rectangle {
            vertical-stretch: 1;
            Flickable {
                width: parent.width;
                height: parent.height;
            content-width: root.column-width;
            VerticalLayout {
                width: root.column-width;
                alignment: start;
                spacing: 12px;
                padding-bottom: 168px;
                Text {
                    text: "Settings";
                    font-size: 32px;
                    font-weight: 700;
                    color: Palette.on-surface;
                }
                Text {
                    text: "Saved next to your library.";
                    wrap: word-wrap;
                    font-size: 14px;
                    color: Palette.on-surface-variant;
                }
                SwitchRow {
                    title: "Track notifications";
                    description: "Show a notification when a new song starts while the window is in the background.";
                    on <=> root.set-notifications;
                    toggled(value) => { root.settings-changed("notifications", value); }
                }
                SwitchRow {
                    title: "Keep playing in the tray";
                    description: "Closing the window hides it to the tray and playback continues.";
                    on <=> root.set-tray;
                    toggled(value) => { root.settings-changed("tray", value); }
                }
                SwitchRow {
                    title: "Dynamic colour";
                    description: "Tint the app with colours from the album art of the current song.";
                    on <=> root.set-dynamic-color;
                    toggled(value) => { root.settings-changed("dynamic-color", value); }
                }
            }
        }
        }

    }

    // The page runs on under the player; songs fade into the background on their way there.
    Rectangle {
        x: 32px + 80px + 24px;
        width: parent.width - self.x - 32px;
        height: 24px + 128px + 48px;
        y: parent.height - self.height;
        // Songs stay fully visible until they come within 48 px of the player; there they fade out,
        // and from the player's top edge down the background is solid, so nothing shows behind it.
        background: @linear-gradient(180deg,
            Palette.background.transparentize(1) 0%,
            Palette.background.transparentize(0.55) 12%,
            Palette.background 24%,
            Palette.background 100%);
    }

    // Player: one glass card, the same width as the column.
    Rectangle {
        x: 32px + 80px + 24px;
        width: parent.width - self.x - 32px;
        height: 128px;
        y: parent.height - 24px - self.height;
        border-radius: 28px;
        background: Palette.glass;
        // Tapping the artwork or title opens (and closes) the Now playing page.
        TouchArea {
            x: 0px;
            y: 0px;
            width: parent.width - 330px;
            height: 88px;
            mouse-cursor: pointer;
            clicked => { root.toggle-up-next(); }
        }
        VerticalLayout {
            padding: 16px;
            spacing: 6px;
            HorizontalLayout {
                spacing: 14px;
                Rectangle {
                    width: 56px;
                    height: 56px;
                    // The plain art, until Rust has cut the morphing outline out of the picture.
                    Art {
                        visible: root.now-art-shaped.width == 0;
                        tint: Palette.accent;
                        source: root.now-art;
                        border-radius: 14px;
                    }
                    Image {
                        visible: root.now-art-shaped.width > 0;
                        source: root.now-art-shaped;
                        width: 56px;
                        height: 56px;
                        image-fit: fill;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: root.now-title;
                        overflow: elide;
                        font-size: 16px;
                        font-weight: 600;
                        color: Palette.on-surface;
                    }
                    Text {
                        text: root.now-message != "" ? root.now-message : root.now-artist;
                        overflow: elide;
                        font-size: 13px;
                        color: Palette.on-surface-variant;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    RoundButton {
                        glyph: root.now-liked
                            ? "M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                            : "M16.5 3c-1.74 0-3.41.81-4.5 2.09C10.91 3.81 9.24 3 7.5 3 4.42 3 2 5.42 2 8.5c0 3.78 3.4 6.86 8.55 11.54L12 21.35l1.45-1.32C18.6 15.36 22 12.28 22 8.5 22 5.42 19.58 3 16.5 3zm-4.4 15.55l-.1.1-.1-.1C7.14 14.24 4 11.39 4 8.5 4 6.5 5.5 5 7.5 5c1.54 0 3.04.99 3.57 2.36h1.87C13.46 5.99 14.96 5 16.5 5c2 0 3.5 1.5 3.5 3.5 0 2.89-3.14 5.74-7.9 10.05z";
                        fill: #00000000;
                        ink: root.now-liked ? #ffb4c8 : #e8e0f0;
                        diameter: 40px;
                        icon-size: 22px;
                        clicked => { root.toggle-like(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    RoundButton {
                        glyph: "M6 6h2v12H6zm3.5 6l8.5 6V6z";
                        diameter: 40px;
                        icon-size: 22px;
                        clicked => { root.previous(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    RoundButton {
                        glyph: root.playing ? "M6 19h4V5H6v14zm8-14v14h4V5h-4z" : "M8 5v14l11-7z";
                        diameter: 68px;
                        icon-size: root.playing ? 34px : 26px;
                        rest-radius: root.playing ? 22px : 34px;
                        shape-image: root.play-shape;
                        loader-image: root.loader-shape;
                        busy: root.loading;
                        fill: Palette.accent;
                        ink: #ffffff;
                        clicked => { root.toggle-pause(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    RoundButton {
                        glyph: "M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z";
                        diameter: 40px;
                        icon-size: 22px;
                        clicked => { root.next(); }
                    }
                }
            }
            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: root.time-position;
                    font-size: 12px;
                    color: Palette.on-surface-variant;
                    vertical-alignment: center;
                    width: 40px;
                }
                seek := SeekBar {
                    horizontal-stretch: 1;
                    progress: root.smooth-progress;
                    wave-image: root.wave-image;
                    wave-extent: root.wave-extent;
                    seek(fraction) => { root.seek(fraction); }
                }
                Text {
                    text: root.time-duration;
                    font-size: 12px;
                    color: Palette.on-surface-variant;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    width: 40px;
                }
            }
        }
    }

    // Message bar
    if root.notice != "" : Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 170px;
        width: min(parent.width - 64px, 520px);
        height: 48px;
        border-radius: 14px;
        background: #3a3347;
        Text {
            text: root.notice;
            font-size: 14px;
            color: Palette.on-surface;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    }
}
