// TweMusic in Slint. The window only draws: all data and playback come from the Rust side
// (twe_music::engine), which fills the properties below and handles the callbacks.

struct Song {
    title: string,
    artist: string,
    tint: color,
    art: image,
}

component Icon inherits Path {
    in property <string> glyph;
    in property <length> size: 24px;
    width: size;
    height: size;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: glyph;
    fill: #e8e0f0;
}

component RailItem inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> selected;
    callback clicked();
    width: 80px;
    height: 64px;
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 56px;
                height: 32px;
                border-radius: 16px;
                background: root.selected ? #4a3a7a : (ta.has-hover ? #ffffff14 : #00000000);
                animate background { duration: 150ms; easing: ease-out; }
                Icon {
                    glyph: root.glyph;
                    size: 22px;
                    fill: root.selected ? #ffffff : #cfc6dc;
                }
            }
        }
        Text {
            text: root.label;
            horizontal-alignment: center;
            font-size: 12px;
            font-weight: root.selected ? 700 : 500;
            color: root.selected ? #ffffff : #cfc6dc;
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Artwork, or a tinted gradient until the picture has loaded.
component Art inherits Rectangle {
    in property <color> tint;
    in property <image> source;
    border-radius: 14px;
    clip: true;
    background: @linear-gradient(135deg, root.tint 0%, root.tint.darker(0.5) 100%);
    Image {
        source: root.source;
        width: parent.width;
        height: parent.height;
        image-fit: cover;
        visible: root.source.width > 0;
    }
}

component RoundButton inherits Rectangle {
    in property <string> glyph;
    in property <length> diameter: 48px;
    in property <length> icon-size: 24px;
    in property <color> fill: #ffffff1f;
    in property <color> ink: #e8e0f0;
    callback clicked();
    width: diameter;
    height: diameter;
    border-radius: diameter / 2;
    background: ta.has-hover ? fill.brighter(0.2) : fill;
    animate background { duration: 120ms; }
    Icon {
        glyph: root.glyph;
        size: root.icon-size;
        fill: root.ink;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

component QuickCard inherits Rectangle {
    in property <Song> song;
    callback clicked();
    height: 56px;
    border-radius: 12px;
    background: ta.has-hover ? #ffffff26 : #ffffff14;
    animate background { duration: 120ms; }
    HorizontalLayout {
        spacing: 12px;
        Art {
            width: 56px;
            tint: root.song.tint;
            source: root.song.art;
            border-radius: 12px;
        }
        Text {
            text: root.song.title;
            vertical-alignment: center;
            overflow: elide;
            font-size: 14px;
            font-weight: 700;
            color: #f4eefc;
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

component ShelfCard inherits Rectangle {
    in property <Song> song;
    callback clicked();
    width: 156px;
    height: 220px;
    VerticalLayout {
        spacing: 6px;
        Art {
            height: 156px;
            tint: root.song.tint;
            source: root.song.art;
        }
        Text {
            text: root.song.title;
            overflow: elide;
            font-size: 14px;
            font-weight: 600;
            color: #f4eefc;
        }
        Text {
            text: root.song.artist;
            overflow: elide;
            font-size: 12px;
            color: #b9aecb;
        }
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

component Shelf inherits VerticalLayout {
    in property <string> heading;
    in property <[Song]> songs;
    callback picked(int);
    spacing: 8px;
    Text {
        text: root.heading;
        font-size: 22px;
        font-weight: 700;
        color: #f4eefc;
    }
    Flickable {
        height: 220px;
        HorizontalLayout {
            spacing: 14px;
            for song[i] in root.songs : ShelfCard {
                song: song;
                clicked => { root.picked(i); }
            }
        }
    }
}

component PickCard inherits Rectangle {
    in property <Song> song;
    in property <string> why;
    in property <bool> playing;
    callback clicked();
    height: 148px;
    border-radius: 28px;
    background: ta.has-hover ? #6750a4cc : #6750a499;
    animate background { duration: 150ms; }
    HorizontalLayout {
        padding: 14px;
        spacing: 16px;
        Art {
            width: 120px;
            tint: root.song.tint;
            source: root.song.art;
            border-radius: 18px;
        }
        VerticalLayout {
            spacing: 4px;
            Text {
                text: "TODAY'S PICK";
                font-size: 12px;
                font-weight: 700;
                color: #d0bcff;
            }
            Text {
                text: root.song.title;
                font-size: 20px;
                font-weight: 700;
                color: #ffffff;
                overflow: elide;
            }
            Text {
                text: root.song.artist;
                font-size: 14px;
                color: #e8def8;
                overflow: elide;
            }
            Text {
                text: root.why;
                font-size: 12px;
                color: #cfc6dc;
            }
        }
        Rectangle {
            width: 48px;
            Rectangle {
                y: parent.height - self.height;
                width: 48px;
                height: 48px;
                border-radius: 24px;
                background: #d0bcff;
                Icon {
                    glyph: root.playing ? "M6 19h4V5H6v14zm8-14v14h4V5h-4z" : "M8 5v14l11-7z";
                    size: 24px;
                    fill: #381e72;
                }
            }
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A thin seek bar: tap or drag to jump.
component SeekBar inherits Rectangle {
    in property <float> progress;
    callback seek(float);
    height: 20px;
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: #ffffff26;
        Rectangle {
            x: 0px;
            width: parent.width * clamp(root.progress, 0, 1);
            border-radius: 2px;
            background: #d0bcff;
        }
    }
    Rectangle {
        x: parent.width * clamp(root.progress, 0, 1) - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: #d0bcff;
    }
    TouchArea {
        clicked => { root.seek(clamp(self.mouse-x / self.width, 0, 1)); }
        moved => {
            if (self.pressed) {
                root.seek(clamp(self.mouse-x / self.width, 0, 1));
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "TweMusic";
    preferred-width: 1100px;
    preferred-height: 760px;
    min-width: 640px;
    min-height: 520px;
    background: #15111d;

    // Home
    in property <string> greeting: "Hello";
    in property <bool> has-pick: false;
    in property <Song> pick;
    in property <string> pick-why;
    in property <[Song]> more;
    in property <[Song]> quick;
    in property <[Song]> recent;
    in property <[Song]> liked;

    // Player
    in property <bool> has-track: false;
    in property <string> now-title: "Nothing playing";
    in property <string> now-artist: "Pick a song to start";
    in property <string> now-message;
    in property <image> now-art;
    in property <bool> playing: false;
    in property <bool> now-liked: false;
    in property <float> progress: 0;
    in property <string> time-position: "0:00";
    in property <string> time-duration: "0:00";

    // A short message at the bottom (errors, confirmations); empty hides it.
    in property <string> notice;

    callback play-pick();
    callback play-more(int);
    callback play-recent(int);
    callback play-liked(int);
    callback toggle-pause();
    callback next();
    callback previous();
    callback seek(float);
    callback toggle-like();

    in-out property <int> screen: 0;

    // Aurora: soft colour blobs behind everything.
    Rectangle {
        background: @radial-gradient(circle, #7b5ea755 0%, #00000000 100%);
        x: -200px;
        y: -240px;
        width: 900px;
        height: 900px;
    }
    Rectangle {
        background: @radial-gradient(circle, #3b6a8a44 0%, #00000000 100%);
        x: parent.width - 600px;
        y: parent.height - 600px;
        width: 800px;
        height: 800px;
    }

    // Floating rail: a glass pill at the left, centred vertically.
    Rectangle {
        x: 32px;
        y: (parent.height - self.height) / 2;
        width: 80px;
        height: 3 * 64px + 2 * 4px + 24px;
        border-radius: 28px;
        background: #ffffff12;
        VerticalLayout {
            padding-top: 12px;
            padding-bottom: 12px;
            spacing: 4px;
            RailItem {
                glyph: "M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z";
                label: "Home";
                selected: root.screen == 0;
                clicked => { root.screen = 0; }
            }
            RailItem {
                glyph: "M20 2H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-2 5h-3v5.5c0 1.38-1.12 2.5-2.5 2.5S10 13.88 10 12.5s1.12-2.5 2.5-2.5c.57 0 1.08.19 1.5.51V5h4v2zM4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6z";
                label: "Library";
                selected: root.screen == 1;
                clicked => { root.screen = 1; }
            }
            RailItem {
                glyph: "M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 00.12-.61l-1.92-3.32a.488.488 0 00-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.484.484 0 00-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58a.49.49 0 00-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z";
                label: "Settings";
                selected: root.screen == 2;
                clicked => { root.screen = 2; }
            }
        }
    }

    // Page column: top bar, content, player. Its right margin equals the rail's left margin.
    VerticalLayout {
        x: 32px + 80px + 24px;
        width: parent.width - self.x - 32px;
        height: parent.height;

        HorizontalLayout {
            height: 64px;
            Text {
                text: "TweMusic";
                vertical-alignment: center;
                font-size: 24px;
                font-weight: 700;
                color: #f4eefc;
            }
        }

        Flickable {
            VerticalLayout {
                spacing: 20px;
                padding-bottom: 16px;
                Text {
                    text: root.greeting;
                    font-size: 32px;
                    font-weight: 700;
                    color: #f4eefc;
                }
                if root.has-pick : PickCard {
                    song: root.pick;
                    why: root.pick-why;
                    playing: root.playing && root.now-title == root.pick.title;
                    clicked => { root.play-pick(); }
                }
                GridLayout {
                    spacing: 8px;
                    for song[i] in root.quick : QuickCard {
                        row: floor(i / 2);
                        col: mod(i, 2);
                        song: song;
                        clicked => { root.play-recent(i); }
                    }
                }
                if root.more.length > 0 : Shelf {
                    heading: "More like today's pick";
                    songs: root.more;
                    picked(i) => { root.play-more(i); }
                }
                if root.recent.length > 0 : Shelf {
                    heading: "Recently played";
                    songs: root.recent;
                    picked(i) => { root.play-recent(i); }
                }
                if root.liked.length > 0 : Shelf {
                    heading: "Liked songs";
                    songs: root.liked;
                    picked(i) => { root.play-liked(i); }
                }
                if !root.has-pick && root.recent.length == 0 && root.liked.length == 0 : Text {
                    text: "Finding something for you…";
                    font-size: 16px;
                    color: #b9aecb;
                }
            }
        }

        // Player: one glass card, the same width as the column.
        Rectangle {
            height: 112px;
            border-radius: 28px;
            background: #ffffff14;
            VerticalLayout {
                padding: 16px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 14px;
                    Art {
                        width: 56px;
                        tint: #6750a4;
                        source: root.now-art;
                        border-radius: 14px;
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: root.now-title;
                            overflow: elide;
                            font-size: 16px;
                            font-weight: 600;
                            color: #f4eefc;
                        }
                        Text {
                            text: root.now-message != "" ? root.now-message : root.now-artist;
                            overflow: elide;
                            font-size: 13px;
                            color: #b9aecb;
                        }
                    }
                    RoundButton {
                        glyph: root.now-liked
                            ? "M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                            : "M16.5 3c-1.74 0-3.41.81-4.5 2.09C10.91 3.81 9.24 3 7.5 3 4.42 3 2 5.42 2 8.5c0 3.78 3.4 6.86 8.55 11.54L12 21.35l1.45-1.32C18.6 15.36 22 12.28 22 8.5 22 5.42 19.58 3 16.5 3zm-4.4 15.55l-.1.1-.1-.1C7.14 14.24 4 11.39 4 8.5 4 6.5 5.5 5 7.5 5c1.54 0 3.04.99 3.57 2.36h1.87C13.46 5.99 14.96 5 16.5 5c2 0 3.5 1.5 3.5 3.5 0 2.89-3.14 5.74-7.9 10.05z";
                        fill: #00000000;
                        ink: root.now-liked ? #ffb4c8 : #e8e0f0;
                        diameter: 40px;
                        icon-size: 22px;
                        clicked => { root.toggle-like(); }
                    }
                    RoundButton {
                        glyph: "M6 6h2v12H6zm3.5 6l8.5 6V6z";
                        diameter: 40px;
                        icon-size: 22px;
                        clicked => { root.previous(); }
                    }
                    RoundButton {
                        glyph: root.playing ? "M6 19h4V5H6v14zm8-14v14h4V5h-4z" : "M8 5v14l11-7z";
                        diameter: 48px;
                        fill: #6750a4;
                        ink: #ffffff;
                        clicked => { root.toggle-pause(); }
                    }
                    RoundButton {
                        glyph: "M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z";
                        diameter: 40px;
                        icon-size: 22px;
                        clicked => { root.next(); }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: root.time-position;
                        font-size: 12px;
                        color: #b9aecb;
                        vertical-alignment: center;
                        width: 40px;
                    }
                    SeekBar {
                        horizontal-stretch: 1;
                        progress: root.progress;
                        seek(fraction) => { root.seek(fraction); }
                    }
                    Text {
                        text: root.time-duration;
                        font-size: 12px;
                        color: #b9aecb;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        width: 40px;
                    }
                }
            }
        }
        Rectangle { height: 24px; }
    }

    // Message bar
    if root.notice != "" : Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 170px;
        width: min(parent.width - 64px, 520px);
        height: 48px;
        border-radius: 14px;
        background: #3a3347;
        Text {
            text: root.notice;
            font-size: 14px;
            color: #f4eefc;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
